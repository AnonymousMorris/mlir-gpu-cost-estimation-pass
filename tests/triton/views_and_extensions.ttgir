#blocked = #ttg.blocked<{sizePerThread = [2], threadsPerWarp = [32], warpsPerCTA = [1], order = [0]}>
#matrix = #ttg.blocked<{sizePerThread = [1, 2], threadsPerWarp = [4, 8], warpsPerCTA = [1, 1], order = [1, 0]}>
#transposed = #ttg.blocked<{sizePerThread = [2, 1], threadsPerWarp = [8, 4], warpsPerCTA = [1, 1], order = [0, 1]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 1 : i32, ttg.target = "cuda:86", "ttg.threads-per-warp" = 32 : i32} {
  tt.func private @bitcast_scalar(%x: i32, %ptr: !tt.ptr<f16>) {
    %y = tt.bitcast %x : i32 -> f32
    %p = tt.bitcast %ptr : !tt.ptr<f16> -> !tt.ptr<f32>
    tt.return
  }

  tt.func private @bitcast_tensor(%x: tensor<128xi32, #blocked>, %ptr: tensor<128x!tt.ptr<f16>, #blocked>) {
    %y = tt.bitcast %x : tensor<128xi32, #blocked> -> tensor<128xf32, #blocked>
    %p = tt.bitcast %ptr : tensor<128x!tt.ptr<f16>, #blocked> -> tensor<128x!tt.ptr<f32>, #blocked>
    tt.return
  }

  tt.func private @bitcast_then_add(%x: tensor<128xi32, #blocked>) {
    %y = tt.bitcast %x : tensor<128xi32, #blocked> -> tensor<128xf32, #blocked>
    %sum = arith.addf %y, %y : tensor<128xf32, #blocked>
    tt.return
  }

  tt.func private @transpose(%x: tensor<8x16xf32, #matrix>) {
    %y = tt.trans %x {order = array<i32: 1, 0>} : tensor<8x16xf32, #matrix> -> tensor<16x8xf32, #transposed>
    tt.return
  }

  tt.func private @transpose_then_convert(%x: tensor<8x16xf32, #matrix>) {
    %y = tt.trans %x {order = array<i32: 1, 0>} : tensor<8x16xf32, #matrix> -> tensor<16x8xf32, #transposed>
    %z = ttg.convert_layout %y : tensor<16x8xf32, #transposed> -> tensor<16x8xf32, #matrix>
    tt.return
  }

  tt.func public @extend_scalar_f16(%x: f16, %out: !tt.ptr<f32>) {
    %y = arith.extf %x : f16 to f32
    tt.store %out, %y : !tt.ptr<f32>
    tt.return
  }

  tt.func public @extend_scalar_bf16(%x: bf16, %out: !tt.ptr<f32>) {
    %y = arith.extf %x : bf16 to f32
    tt.store %out, %y : !tt.ptr<f32>
    tt.return
  }

  tt.func private @extend_tensor_f16(%x: tensor<128xf16, #blocked>) {
    %y = arith.extf %x : tensor<128xf16, #blocked> to tensor<128xf32, #blocked>
    tt.return
  }

  tt.func private @extend_tensor_bf16(%x: tensor<128xbf16, #blocked>) {
    %y = arith.extf %x : tensor<128xbf16, #blocked> to tensor<128xf32, #blocked>
    tt.return
  }

  tt.func private @extend_f32_f64(%x: tensor<128xf32, #blocked>) {
    %y = arith.extf %x : tensor<128xf32, #blocked> to tensor<128xf64, #blocked>
    tt.return
  }

  tt.func private @extend_unconfigured(%x: f64) {
    %y = arith.extf %x : f64 to f128
    tt.return
  }
}
